# Email delivery service. These describe the SENDER, not the alert recipient.
APACHEWATCH_SMTP_HOST=
APACHEWATCH_SMTP_PORT=587
APACHEWATCH_SMTP_SECURITY=starttls
APACHEWATCH_SMTP_USERNAME=
APACHEWATCH_SMTP_PASSWORD=
APACHEWATCH_EMAIL_FROM=

# Optional public dashboard address used in alert links.
APACHEWATCH_PUBLIC_URL=
